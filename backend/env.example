# Copy to .env next to server.py (chmod 600). Real environment variables win over this file.
# Restart the gateway (server.py) after changes.

# --- Models and services (defaults = the demonstration set-up; all optional) ---
# Identifiers sent to the OpenAI-compatible services, and the names the console shows.
#ORANGE_LLM_MODEL=google/gemma-4-26b-a4b-it
#ORANGE_CALLER_MODEL=google/gemma-4-26b-a4b-it     # the simulated caller (defaults to ORANGE_LLM_MODEL)
#ORANGE_TTS_MODEL=mistralai/Voxtral-4B-TTS-2603
#ORANGE_STT_MODELS=nemotron,parakeet               # comma-separated; the first one is the default
#ORANGE_TTS_VOICES=fr_female,fr_male
#ORANGE_LLM_LABEL=Gemma 4                          # display names (default: demo names, else the id's last segment)
#ORANGE_TTS_LABEL=Voxtral
# Service endpoints (localhost by default): ORANGE_GEMMA_URL, ORANGE_STT_URL, ORANGE_TTS_URL; listen address: ORANGE_BIND.

# --- Caller sites: the simulated caller as a separate service (caller/service.py) at one or more locations ---
# name=url entries, comma-separated. New calls are spread over the ready sites; the console measures every turn
# per site (GET /api/latency, tools/db_report.py --latency). Without this the gateway's built-in caller plays every call.
#ORANGE_CALLERS=paris=http://10.0.0.5:8094,montreal=https://caller-yul.example
#ORANGE_CALLER_TOKEN=                              # bearer token the sites expect (their CALLER_TOKEN)
#ORANGE_CALLER_TIMEOUT=60                          # seconds allowed for one remote turn
#ORANGE_CALLER_FALLBACK=1                          # 0: a failing site is an error instead of a fallback to the built-in caller

# --- Option A: out-of-band F5 AI Guardrails (Scans API), called by the gateway itself ---
# Scans the caller's latest words before the model (scanDirection=request) and the AI's spoken
# reply after it (response). Needs a project-scoped token from the AI Security console.
F5_GUARDRAILS_URL=https://www.us1.calypsoai.app
F5_GUARDRAILS_TOKEN=
F5_GUARDRAILS_PROJECT=
# enforce: "blocked" stops the AI and hands the call to a human, redactedInput replaces the text.
# monitor: verdicts are shown, nothing is blocked.
F5_GUARDRAILS_MODE=enforce
# Scan the spoken reply too (1) or only the caller's words (0).
F5_GUARDRAILS_SCAN_RESPONSE=1
# When the tenant is unreachable: open (AI continues, verdict "injoignable") or closed (AI stops).
F5_GUARDRAILS_ON_ERROR=open
F5_GUARDRAILS_TIMEOUT=8

# --- Option B (F5's demo path): the tee proxy inserted on the LLM path, run by guardrail_proxy.sh ---
# Only /api/analyze goes through it; the proxy's own .env (project, token, modes, webhook, block
# message, RESPONSE_HOLD) is F5's tee-proxy.env, not this file. Blocks come back as HTTP 200 with a
# substituted sentence and X-Tee-Prompt-Action: blocked; the gateway reads X-Tee-* headers.
#ORANGE_LLM_URL=http://127.0.0.1:8100/v1/chat/completions
# Simulated caller: leave on the direct model unless you want to test the proxy on it too.
#ORANGE_CALLER_LLM_URL=http://127.0.0.1:8000/v1/chat/completions
