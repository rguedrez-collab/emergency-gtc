# F5 AI Guardrails tee proxy, run by guardrail_proxy.sh in front of the local LLM endpoint.
# Copy to tee-proxy.env next to the script (chmod 600), fill in the registry/image/user and the F5
# token/project (all provided by F5), then: bash guardrail_proxy.sh start.
# Variable names and defaults come from the image's config.py.

# Container image and registry, provided by F5. The pull password goes in .acr-password, never here.
ACR_REGISTRY=
ACR_IMAGE=
ACR_USER=

# Upstream LLM: the local OpenAI-compatible endpoint (the image defaults to a remote endpoint, so this line is required).
UPSTREAM_URL=http://127.0.0.1:8000
UPSTREAM_TIMEOUT_S=300

# F5 AI Guardrails tenant (image default: EU1). Project-scoped token from the AI Security console.
F5_AIS_URL=https://eu1.calypsoai.app
F5_AIS_TOKEN=
F5_AIS_PROJECT=
F5_AIS_TIMEOUT_S=30
# Test the whole chain without a tenant: F5_AIS_MOCK=true (keyword rules, not real guardrails).
F5_AIS_MOCK=false

# Enforcement. monitor = scans out-of-band, nothing changes (default); enforce = block/redact inline.
GUARDRAIL_MODE=enforce
# Hold the answer until its scan is done (blocked reply -> BLOCK_MESSAGE, redacted -> masked reply).
RESPONSE_HOLD=true
# Scan error/timeout: true lets the traffic through (failed_open), false blocks it (failed_closed).
ENFORCE_FAIL_OPEN=true
ENFORCE_TIMEOUT_S=10
# Spoken by the console when a block replaces the model's answer. {reason} = guardrail names.
BLOCK_MESSAGE=Je ne peux pas répondre à cette demande. Motif : {reason}.
BLOCK_REASON_FALLBACK=politique de sécurité

# What is scanned: the last user message (our whole dialogue JSON) and the answer.
SCAN_PROMPT=true
SCAN_RESPONSE=true
SCAN_MODE=last_user
# Above this size a redaction becomes a block; our dialogue JSON stays under ~18k.
SCAN_MAX_CHARS=40000
METADATA_SOURCE=orange-voice-poc

# Demo dashboard (second container from the same image, see guardrail_proxy.sh). With --network host,
# the receiver is reached on 127.0.0.1, not on the compose name "webhook-receiver".
WEBHOOK_URL=http://127.0.0.1:9090/webhook
WEBHOOK_EVENTS=all
WEBHOOK_INCLUDE_TEXT=true
WEBHOOK_SEND_ORIGINAL=false

LISTEN_PORT=8100
LOG_LEVEL=INFO
