# Copy to caller/.env next to service.py (chmod 600). Real environment variables win over this file.
# One caller service per site; the console's gateway lists them in ORANGE_CALLERS (name=url,...).

CALLER_LOCATION=paris                 # the name the console shows for this site
CALLER_BIND=0.0.0.0
CALLER_PORT=8094
# The gateway presents this token (ORANGE_CALLER_TOKEN). Leave empty only on a private network.
CALLER_TOKEN=

# Models next to this service (OpenAI-compatible): the caller's lines and its voice.
CALLER_LLM_URL=http://127.0.0.1:8000/v1/chat/completions
CALLER_LLM_MODEL=google/gemma-4-26b-a4b-it
CALLER_TTS_URL=http://127.0.0.1:8011
CALLER_TTS_MODEL=mistralai/Voxtral-4B-TTS-2603
CALLER_TTS_VOICES=fr_female,fr_male
CALLER_TIMEOUT=60

# Without models (topology demos, tests): scripted lines and silent audio carrying its text.
#CALLER_FAKE=1
#CALLER_FAKE_LLM_MS=900
#CALLER_FAKE_TTS_MS=700
#CALLER_FAKE_DELAY_MS=0               # extra delay per turn, to stand in for distance
